
# Cloned conditionally by scripts/install-job-skills.sh, not a submodule:
# it is private, and this repo is public, so a submodule would break --recursive
# for everyone without access. See job-skills/docs/adr/0002.
job-skills/
obsidian-job-doc/
identity/

# Client prod DB credentials for the db-tunnel module. Public repo — never commit.
scripts/db-tunnel.env
# ...and any local variant of it. `scripts/db-tunnel.env` alone did not cover
# `db-tunnel.env.bak`, which sat untracked in the working tree carrying real
# production credentials while `git status` offered it up for commit like any
# other new file. The .example is the only member of this family that belongs
# in the repo.
scripts/*.env.*
!scripts/*.env.example

# local DataGrip config backups taken before agent edits
.datagrip-backup-*/
