# Copy this file to db-tunnel.env (which is gitignored) and fill it in.
# NEVER commit the filled-in copy — this repo is public.

# --- The home Mac that holds the client-allowlisted residential IP -----------
# It runs as the SSH pivot. Reach it over Tailscale (no port forwarding needed).
HOME_PIVOT=                      # home Mac Tailscale IP (or its MagicDNS name)
HOME_USER=                       # macOS username on the home Mac (`whoami` there)
HOME_SSH_KEY=                    # path to the dedicated ssh key, e.g. ~/.ssh/id_ed25519-...
EXIT_NODE=                       # home Mac's Tailscale name, for db-gui-mode.sh full tunnel

# --- The client's production MSSQL endpoint (given to you by the client) ------
PROD_HOST=                       # hostname or IP of the prod SQL Server
PROD_PORT=1433

# --- The login, for db-query.sh only (optional) --------------------------------
# Leave these blank when the credential is kept in a store of its own and the
# client only borrows the tunnel (`db-tunnel.sh up`, then `db-tunnel.sh target`
# to learn where the forward listens). A second copy here is a second place to
# rotate and a second place to leak.
DB_NAME=                         # database / initial catalog
DB_USER=                         # read-only SQL login
DB_PASSWORD=                     # read-only password

# --- Local end of the ssh -L forward -----------------------------------------
# 14330 avoids colliding with the local-stack SQL Server on 1433.
LOCAL_PORT=14330
